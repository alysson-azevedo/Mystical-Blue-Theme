# Mystical Blue (JuxTheme) — cores derivadas do esquema do KDE
background = #25272f
foreground = #e3e3e3
background-opacity = 0.63
background-blur = true

cursor-color = #3e6fd9
cursor-text = #fcfcfc
selection-background = #474f71
selection-foreground = #fcfcfc

# us-intl: Shift+` é dead key (til). O Ghostty não compõe dead keys com esse
# layout no Wayland — este bind emite ~ direto.
keybind = shift+backquote=text:~

palette = 0=#31333f
palette = 1=#e06c75

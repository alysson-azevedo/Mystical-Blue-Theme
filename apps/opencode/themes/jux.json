{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.blue.200",
          "$selected": "$hue.blue.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.blue.200",
        "$focused": "$hue.blue.200",
        "$pressed": "$hue.blue.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.blue.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#2b2e38",
        "high": "#333744",
        "max": "#3b4050"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.high",
          "$focused": "$hue.blue.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#474f71" },
    "scrollbar": { "base": "#3f4557" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "#828bb8",
        "hunkHeader": "#828bb8"
      },
      "background": {
        "added": "#223528",
        "removed": "#3a2226",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#b8db87",
        "removed": "#e26a75"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#1b2b34",
          "removed": "#2d1f26"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.blue.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.yellow.200",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.blue.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#e3e3e3",
        "300": "#b8bdc9",
        "400": "#8b93a3",
        "500": "#5f6776",
        "600": "#454c5c",
        "700": "#2b2e38",
        "800": "#25272f",
        "900": "#1e2027"
      },
      "red": {
        "100": "#f5b8be",
        "200": "#e06c75",
        "300": "#cd5a63",
        "400": "#b14a52",
        "500": "#933b42",
        "600": "#752c32",
        "700": "#581e23",
        "800": "#3a1216",
        "900": "#1c0709"
      },
      "orange": {
        "100": "#ffd9a8",
        "200": "#f5a742",
        "300": "#dd9234",
        "400": "#c47d2b",
        "500": "#a66722",
        "600": "#87511a",
        "700": "#683c12",
        "800": "#47270a",
        "900": "#241304"
      },
      "yellow": {
        "100": "#f2e2c0",
        "200": "#e5c07b",
        "300": "#cda668",
        "400": "#b58c55",
        "500": "#977243",
        "600": "#785932",
        "700": "#5a4121",
        "800": "#3b2911",
        "900": "#1d1306"
      },
      "green": {
        "100": "#c6e9bc",
        "200": "#98c379",
        "300": "#82a966",
        "400": "#6c8f52",
        "500": "#56743e",
        "600": "#415a2b",
        "700": "#2c4018",
        "800": "#1c2b0c",
        "900": "#0b1503"
      },
      "cyan": {
        "100": "#a8e6ee",
        "200": "#56b6c2",
        "300": "#47a0ab",
        "400": "#388994",
        "500": "#2a727d",
        "600": "#1f5862",
        "700": "#153f47",
        "800": "#0b262c",
        "900": "#041114"
      },
      "blue": {
        "100": "#a7c8fb",
        "200": "#5c8ae6",
        "300": "#4d7cd9",
        "400": "#3e6fd9",
        "500": "#3660c2",
        "600": "#2c50a0",
        "700": "#23407e",
        "800": "#1a3060",
        "900": "#11203f"
      },
      "purple": {
        "100": "#e7c6f4",
        "200": "#c678dd",
        "300": "#ad62c4",
        "400": "#944daa",
        "500": "#7c3990",
        "600": "#632a74",
        "700": "#4a1c58",
        "800": "#310f3b",
        "900": "#18061e"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}